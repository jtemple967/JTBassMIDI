@prefix atom:   <http://lv2plug.in/ns/ext/atom#> .
@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix midi:   <http://lv2plug.in/ns/ext/midi#> .
@prefix mod:    <http://moddevices.com/ns/mod#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units:  <http://lv2plug.in/ns/extensions/units#> .
@prefix urid:   <http://lv2plug.in/ns/ext/urid#> .

<https://github.com/jtemple967/JTBassMIDI>
	a lv2:Plugin , lv2:MIDIPlugin ;
	doap:name "JTBassMIDI" ;
	doap:license <http://opensource.org/licenses/GPL-3.0> ;
	doap:maintainer [
		a foaf:Person ;
		foaf:name "Jonas Temple"
	] ;
	doap:homepage <https://github.com/jtemple967/JTBassMIDI> ;
	doap:repository [
		a doap:GitRepository ;
		doap:location <https://github.com/jtemple967/JTBassMIDI.git> ;
		doap:browse <https://github.com/jtemple967/JTBassMIDI>
	] ;
	mod:brand "JT" ;
	mod:label "Bass MIDI" ;
	lv2:minorVersion 1 ;
	lv2:microVersion 0 ;
	rdfs:comment "Monophonic bass-to-MIDI converter. Tracks the pitch of a bass guitar and sends MIDI notes with velocity and optional pitch bend. The audio passes through, so it can sit inline on a pedalboard." ;
	lv2:requiredFeature urid:map ;
	lv2:optionalFeature lv2:hardRTCapable ;
	lv2:port [
		a lv2:AudioPort , lv2:InputPort ;
		lv2:index 0 ;
		lv2:symbol "in" ;
		lv2:name "In"
	] , [
		a lv2:AudioPort , lv2:OutputPort ;
		lv2:index 1 ;
		lv2:symbol "out" ;
		lv2:name "Out"
	] , [
		a atom:AtomPort , lv2:OutputPort ;
		atom:bufferType atom:Sequence ;
		atom:supports midi:MidiEvent ;
		lv2:index 2 ;
		lv2:symbol "midi_out" ;
		lv2:name "MIDI Out"
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 3 ;
		lv2:symbol "enabled" ;
		lv2:name "Enabled" ;
		lv2:designation lv2:enabled ;
		lv2:portProperty lv2:toggled , lv2:integer ;
		lv2:default 1 ;
		lv2:minimum 0 ;
		lv2:maximum 1
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 4 ;
		lv2:symbol "thru" ;
		lv2:name "Thru" ;
		rdfs:comment "Level of the bass passed through to the audio output." ;
		lv2:default 1.0 ;
		lv2:minimum 0.0 ;
		lv2:maximum 1.0
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 5 ;
		lv2:symbol "channel" ;
		lv2:name "Channel" ;
		lv2:portProperty lv2:integer ;
		lv2:default 1 ;
		lv2:minimum 1 ;
		lv2:maximum 16
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 6 ;
		lv2:symbol "transpose" ;
		lv2:name "Transpose" ;
		lv2:portProperty lv2:integer ;
		units:unit units:semitone12TET ;
		lv2:default 0 ;
		lv2:minimum -24 ;
		lv2:maximum 24
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 7 ;
		lv2:symbol "sensitivity" ;
		lv2:name "Gate Threshold" ;
		units:unit units:db ;
		lv2:default -48.0 ;
		lv2:minimum -80.0 ;
		lv2:maximum -10.0
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 8 ;
		lv2:symbol "dynamics" ;
		lv2:name "Dynamics" ;
		rdfs:comment "0 sends every note at velocity 100; 1 follows your picking strength fully." ;
		lv2:default 0.7 ;
		lv2:minimum 0.0 ;
		lv2:maximum 1.0
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 9 ;
		lv2:symbol "bend_range" ;
		lv2:name "Bend Range" ;
		rdfs:comment "Set this to the receiving synth's pitch-bend range. 0 turns pitch bend off and quantises to the nearest note." ;
		lv2:portProperty lv2:integer ;
		units:unit units:semitone12TET ;
		lv2:default 2 ;
		lv2:minimum 0 ;
		lv2:maximum 24 ;
		lv2:scalePoint [ rdfs:label "Off" ; rdf:value 0 ]
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 10 ;
		lv2:symbol "hold" ;
		lv2:name "Hold" ;
		rdfs:comment "Keeps the note sounding after the string stops. Hold Mode sets what ends it: a different note (Normal), only Release (Latch), or Stack, where new notes are added on top until Release." ;
		lv2:portProperty lv2:toggled , lv2:integer ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 1
	] , [
		a lv2:ControlPort , lv2:OutputPort ;
		lv2:index 11 ;
		lv2:symbol "note" ;
		lv2:name "Note" ;
		rdfs:comment "MIDI note currently sounding, or -1." ;
		lv2:default -1 ;
		lv2:minimum -1 ;
		lv2:maximum 127
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 12 ;
		lv2:symbol "release" ;
		lv2:name "Release" ;
		rdfs:comment "Momentary: ends the sounding note (for example one kept by Hold). The string is ignored until the next pluck." ;
		lv2:portProperty lv2:toggled , lv2:integer , pprops:trigger ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 1
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 13 ;
		lv2:symbol "hold_mode" ;
		lv2:name "Hold Mode" ;
		rdfs:comment "How Hold behaves. Normal: the held note sustains until a different note is played. Latch: the held note sustains until Release; other notes are ignored. Stack: each new note is added on top of the held ones (up to three; the oldest is dropped) until Release, so you can build a chord one note at a time. No pitch bend in Stack." ;
		lv2:portProperty lv2:integer , lv2:enumeration ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 2 ;
		lv2:scalePoint [ rdfs:label "Normal" ; rdf:value 0 ] ,
		               [ rdfs:label "Latch" ;  rdf:value 1 ] ,
		               [ rdfs:label "Stack" ;  rdf:value 2 ]
	] .
